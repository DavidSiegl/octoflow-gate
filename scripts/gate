#!/usr/bin/env bash
# Judge the change this working tree makes since BASE with the gate itself: install what the
# tests need, then run the judge's gate with the judge's settings (gate.toml) and rules (its
# pyproject.toml), so that a change cannot loosen how it is itself judged
# (docs/quality-gate.md says what each check means). The gate is the release the judge's
# ci/gate.pin names, fetched with the judge's ci/fetch-gate.sh as a project fetches it. A
# release's gate is built for Linux x86_64 alone (README.md, "Running the gate in a project"),
# so on any other machine the change cannot be judged. The gate runs the tests, with the
# `[[test]]` commands of the judge's gate.toml.
#
#   scripts/gate [BASE]     BASE is any git revision; default the branch main, read as
#                           refs/heads/main so a tag main cannot stand in (gitrevisions(7)).
#
# The judge is BASE's commit, except in a Jenkins build of a pull request (CHANGE_TARGET set),
# where it is the target branch's tip, refs/remotes/origin/$CHANGE_TARGET, as the
# Jenkinsfile's Change stage fetched it: a rule tightened on main after the branch left it
# then judges the pull request before auto-merge takes it, instead of first failing main's
# next build.
#
# Jenkins runs it on every pull request (from its merge base with main) and on main (from the
# last passing build) unless a pull request build already judged that tree (ci/judged-at-pr.sh),
# and judges by its exit status alone: 0 for GATE: OK, 1 for GATE: ERROR
# (quality.md says why), 2 when the change could not be judged, and 130 when the gate was
# interrupted. It cannot be judged when a tool is missing; BASE or the judge is not a commit;
# the judge lacks ci/gate.pin, ci/fetch-gate.sh, pyproject.toml, or a gate.toml listing a
# [[test]] command; the judge pins a release that cannot be downloaded or does not match its
# sha256; the judge or the change pins a release that ships no gate (released_gate, below);
# the change pins a release that cannot be fetched, or one that would refuse the change's
# gate.toml (below, where the check is); or the gate itself could not judge. A
# failing test, or a test command that could not run, is the gate's to report. It leaves at
# the repo root quality.md and quality.json, which Jenkins archives, and the reports the
# judge's test commands write, which Jenkins publishes the JUnit ones of.
#
# In a Jenkins build (JENKINS_URL set, as Jenkins sets it for every build; WORKSPACE alone
# may be any shell's or dev container's), crates are fetched into the workspace (CARGO_HOME), so
# no build compiles sources an earlier one left, and temporary files go under WORKSPACE_TMP
# rather than /tmp: the tests and the gate build Rust in temporary directories and run what
# they build, and on the agent /tmp is the container's writable layer, where Falco reports
# every program run from a file written there ("Drop and execute new binary in container").
#
# cargo-llvm-cov, cargo-nextest and cargo-mutants are taken from PATH when all three are
# there, else downloaded by ci/install-tools.sh into .tools/bin, pinned; rustup's clippy and
# llvm-tools components must be installed, since a build cannot add to the agent's rustup
# home, which is root's. uv installs the Python tools pyproject.toml lists, the linters the
# gate runs and what its tests run them and pytest with, and the gate runs among them.
set -euo pipefail
# Any failure before the gate runs is "could not judge", whatever the command's status.
trap 'exit 2' ERR
export UV_NO_PROGRESS=1

top=$(git rev-parse --show-toplevel)
cd "$top"
base_name=${1:-refs/heads/main}
# Resolved before the tests run, which could move a ref.
if ! base=$(git rev-parse --verify --quiet "$base_name^{commit}"); then
	echo "gate: $base_name is not a commit" >&2
	exit 2
fi
# The full ref, since a tag or branch named origin/<target> would win over a short name.
judge_rev=${CHANGE_TARGET:+refs/remotes/origin/$CHANGE_TARGET}
judge_rev=${judge_rev:-$base_name}
if ! judge=$(git rev-parse --verify --quiet "$judge_rev^{commit}"); then
	echo "gate: the judge $judge_rev is not a commit" >&2
	exit 2
fi
# What is taken from the judge: the release it pins and how to fetch it, its settings and rules.
judge_paths=(ci/gate.pin ci/fetch-gate.sh pyproject.toml gate.toml)
for path in "${judge_paths[@]}"; do
	if ! git cat-file -e "$judge:$path" 2>/dev/null; then
		echo "gate: $judge_rev has no $path to judge with" >&2
		exit 2
	fi
done
# The gate runs the tests, with the judge's gate.toml's [[test]] commands: without one it
# would judge the change on no test at all, and pass it whatever its tests do.
if ! git show "$judge:gate.toml" | grep -q '^\[\[test\]\]'; then
	echo "gate: $judge_rev's gate.toml lists no [[test]] command, so no test would be judged" >&2
	exit 2
fi
# The verdict is gitignored and outlives a run: removed, so a run that ends early cannot leave
# the last one. The gate removes each test command's reports before it runs it.
rm -f quality.md quality.json

if [[ -n ${JENKINS_URL:-} ]]; then
	if [[ -z ${WORKSPACE:-} || -z ${WORKSPACE_TMP:-} ]]; then
		echo "gate: JENKINS_URL is set but WORKSPACE or WORKSPACE_TMP is not, as no Jenkins build leaves them" >&2
		exit 2
	fi
	export CARGO_HOME="$WORKSPACE/.cargo-home"
	# What an earlier build left in TMPDIR goes first: on the volume, unlike in /tmp, it would
	# stay. The chmod is for a directory a killed test left without write permission; a
	# clear-out that still fails only warns, since failing would fail every later build of
	# this workspace until someone cleaned the volume by hand.
	export TMPDIR="$WORKSPACE_TMP/tmp"
	if [[ -e $TMPDIR ]]; then
		{ chmod -R u+rwX "$TMPDIR" && rm -rf "$TMPDIR"; } ||
			echo "gate: could not empty $TMPDIR; what an earlier build left there stays" >&2
	fi
	mkdir -p "$TMPDIR"
fi

if [[ $(uname -sm) != "Linux x86_64" ]]; then
	echo "gate: the release's gate is built for Linux x86_64, not $(uname -sm)" >&2
	exit 2
fi
# The judge's settings, rules and gate.
judge_dir=$(mktemp -d)
trap 'rm -rf "$judge_dir"' EXIT
git archive "$judge" "${judge_paths[@]}" | tar -x -C "$judge_dir"

# released_gate DIR VERSION WHOSE: the path of the gate of octoflow-gate VERSION, the release
# unpacked into DIR, which WHOSE ci/gate.pin pins; fails, saying so, when that release ships no
# gate. 0.7.0 is the first that does, and this script runs no earlier one: pinning one is a revert
# of the change that stopped running 0.6.0's gate-linux-x86_64 (gate-standalone/18, step C).
released_gate() {
	if [[ ! -x $1/gate ]]; then
		echo "gate: octoflow-gate $2, the release $3 ci/gate.pin pins, ships no gate;" \
			"0.7.0 is the first that does" >&2
		return 1
	fi
	echo "$1/gate"
}
version=$("$judge_dir/ci/fetch-gate.sh" "$judge_dir/ci/gate.pin" "$judge_dir/release")
gate=$(released_gate "$judge_dir/release" "$version" "$judge_rev's") || exit 2
echo "gate: judging with octoflow-gate $version, the release $judge_rev's ci/gate.pin pins" >&2

# Given the judge's gate.toml, the gate takes its rules from the pyproject.toml beside it, never
# from the change's own.
gate_args=(--base "$base" --config "$judge_dir/gate.toml")

# Once merged, the change's gate.toml is read by the gate the change pins, which refuses a key
# it does not know: a gate.toml ahead of its pin would leave every later change unjudgeable,
# the one that raises the pin included. So the change's gate.toml must load under the release
# the change's ci/gate.pin names, fetched with the judge's ci/fetch-gate.sh; a change may
# raise the pin and use what the new release reads in one go. No release's gate reads a
# gate.toml but to judge by it, so that gate judges an empty change by this one, in a
# repository made for it, from a test report given so that no test command runs.
if [[ ! -e ci/gate.pin ]]; then
	echo "gate: the change deletes ci/gate.pin, by which every later change would be judged" >&2
	exit 2
elif cmp -s ci/gate.pin "$judge_dir/ci/gate.pin"; then
	next_gate=$gate
else
	next_version=$("$judge_dir/ci/fetch-gate.sh" ci/gate.pin "$judge_dir/next-release")
	next_gate=$(released_gate "$judge_dir/next-release" "$next_version" "the change's") || exit 2
fi
empty=$judge_dir/empty
git init --quiet --initial-branch=main "$empty"
git -C "$empty" -c user.name=gate -c user.email=gate@localhost -c commit.gpgSign=false \
	commit --quiet --allow-empty -m empty
echo '<testsuites/>' >"$judge_dir/no-tests.xml"
next_gate_args=(--base HEAD --config "$top/gate.toml" --tests "$judge_dir/no-tests.xml")
if ! (cd "$empty" && "$next_gate" "${next_gate_args[@]}" >/dev/null); then
	echo "gate: the release ci/gate.pin pins could not judge by this gate.toml, for what it said above;" \
		"one it refuses needs the pin raised first" >&2
	exit 2
fi

installed=$(rustup component list --installed)
for component in clippy llvm-tools; do
	if ! grep -q "^$component-" <<<"$installed"; then
		echo "gate: rustup's $component component is not installed; the agent image must add it" >&2
		exit 2
	fi
done
# command -v succeeds when any one of several names is found, so each is asked alone.
# install-tools.sh keeps what an earlier run downloaded from the same pins.
for tool in cargo-llvm-cov cargo-nextest cargo-mutants; do
	if ! command -v "$tool" >/dev/null; then
		ci/install-tools.sh "$top/.tools/bin"
		export PATH="$top/.tools/bin:$PATH"
		break
	fi
done
uv sync --frozen

trap - ERR
status=0
# `python` is the environment's, which holds what the gate's checks of Python run: pytest,
# pytest-randomly and mutmut.
uv run --frozen "$gate" "${gate_args[@]}" --python python --out quality.md || status=$?
case $status in
0 | 1 | 130) ;;
*) status=2 ;;
esac
exit "$status"
